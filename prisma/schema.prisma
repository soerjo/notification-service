generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationChannel {
  SOCKET_IO
  TELEGRAM
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  RETRY
}

enum DeliveryLogStatus {
  SUCCESS
  FAILED
}

model NotificationPlatform {
  id        String              @id @default(uuid())
  domainId  String?             @map("domain_id") @db.VarChar(64)
  channel   NotificationChannel
  name      String              @db.VarChar(100)
  isActive  Boolean             @default(true) @map("is_active")
  isDefault Boolean             @default(false) @map("is_default")
  config    Json                @default("{}")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([domainId, channel, name])
  @@index([domainId])
  @@map("notification_platforms")
}

model Template {
  id          String              @id @default(uuid())
  domainId    String?             @map("domain_id") @db.VarChar(64)
  code        String              @db.VarChar(64)
  channel     NotificationChannel
  name        String              @db.VarChar(128)
  description String?             @db.Text
  subject     String?             @db.VarChar(255) // For Email Subject / Notification Title
  body        String              @db.Text        // Handlebars string/HTML (e.g. HTML email, Markdown telegram, text whatsapp)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([domainId, code, channel])
  @@index([domainId])
  @@map("templates")
}

model Notification {
  id              String              @id @default(uuid())
  traceId         String              @map("trace_id") @db.VarChar(64)
  idempotencyKey  String              @unique @map("idempotency_key") @db.VarChar(255)
  domainId        String?             @map("domain_id") @db.VarChar(64)
  channel         NotificationChannel
  recipientId     String              @map("recipient_id") @db.VarChar(128)
  recipientTarget String              @map("recipient_target") @db.VarChar(255)
  templateCode    String?             @map("template_code") @db.VarChar(64)
  title           String              @db.VarChar(255)
  content         String              @db.Text
  payload         Json                @default("{}")
  status          NotificationStatus  @default(PENDING)
  retryCount      Int                 @default(0) @map("retry_count")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  deliveryLogs NotificationDeliveryLog[]

  @@index([traceId])
  @@index([domainId])
  @@index([status])
  @@index([idempotencyKey(ops: raw("text_pattern_ops"))], map: "notifications_idempotency_key_pattern_idx")
  @@map("notifications")
}

model NotificationDeliveryLog {
  id               BigInt            @id @default(autoincrement())
  notificationId   String            @map("notification_id")
  attempt          Int
  status           DeliveryLogStatus
  providerResponse Json              @default("{}") @map("provider_response")
  latencyMs        Int               @map("latency_ms")
  createdAt        DateTime          @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_delivery_logs")
}
